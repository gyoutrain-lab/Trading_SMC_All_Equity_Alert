// Cloudflare Worker: free market-data relay for SMC Analyzer (no API key, no storage).
// Deploy: dash.cloudflare.com > Workers & Pages > Create > Hello World > Edit code > paste this > Deploy.
// Then paste the https://<name>.<account>.workers.dev URL into "Feed Worker URL" in the app header.
const ALLOW = [
  'api.kraken.com',
  'query1.finance.yahoo.com', 'query2.finance.yahoo.com',
  'fapi.binance.com', 'api.binance.com', 'data-api.binance.vision',
  'api.bybit.com'
];
export default {
  async fetch(req) {
    const cors = {
      'access-control-allow-origin': '*',
      'access-control-allow-methods': 'GET,OPTIONS',
      'access-control-allow-headers': '*'
    };
    if (req.method === 'OPTIONS') return new Response(null, { headers: cors });
    let u;
    try { u = new URL(new URL(req.url).searchParams.get('url')); }
    catch (e) { return new Response('missing or bad ?url=', { status: 400, headers: cors }); }
    if (u.protocol !== 'https:' || !ALLOW.includes(u.hostname))
      return new Response('host not allowed', { status: 403, headers: cors });
    const r = await fetch(u.toString(), {
      headers: { 'user-agent': 'Mozilla/5.0', accept: 'application/json' },
      cf: { cacheTtl: 15, cacheEverything: true }
    });
    const h = new Headers(r.headers);
    for (const k in cors) h.set(k, cors[k]);
    return new Response(r.body, { status: r.status, headers: h });
  }
};
